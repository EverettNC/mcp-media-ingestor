        except subprocess.TimeoutExpired:
            return {"error": "Timed out after 30s."}
        except Exception as exc:
            return {"error": str(exc)}
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass

    return await asyncio.to_thread(_run_py)


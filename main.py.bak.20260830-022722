def _pcm16_to_wav(pcm: bytes, sample_rate: int) -> bytes:
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(int(sample_rate))
        wf.writeframes(pcm)
    return buf.getvalue()


def porch_status() -> dict:
    try:
        req = urllib.request.Request(PORCH_STT_URL, method="GET")
        with urllib.request.urlopen(req, timeout=2) as resp:
            body = json.loads(resp.read().decode("utf-8"))
        body.setdefault("organ", "porch")
        body["whisper"] = False
        body["house"] = body.get("house") or PORCH_HOUSE
        return body
    except Exception as exc:
        return {
            "ok": False,
            "organ": "porch",
            "whisper": False,
            "house": PORCH_HOUSE,
            "error": str(exc),
        }


def _porch_via_house(wav: bytes) -> str:
    payload = json.dumps({
        "audioBase64": base64.b64encode(wav).decode("ascii"),
        "mime": "audio/wav",
        "filename": "bridge.wav",
        "source": "mic",
    }).encode("utf-8")
    req = urllib.request.Request(
        PORCH_STT_URL,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            body = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        try:
            body = json.loads(raw)
        except json.JSONDecodeError:
            raise RuntimeError(f"Porch word-ear failed ({exc.code}): {raw[:240]}") from exc
    if not body.get("ok"):
        raise RuntimeError(body.get("error") or "Porch sent back silence")
    take = body.get("take") or {}
    return str(take.get("asSaid") or take.get("forTheFamily") or take.get("rawEar") or "").strip()


def _porch_via_grok_stt(wav: bytes, key: str) -> str:
    import requests
    res = requests.post(
        "https://api.x.ai/v1/stt",
        headers={"Authorization": f"Bearer {key}"},
        data={"model": "grok-stt", "language": "en", "format": "true"},
        files={"file": ("bridge.wav", wav, "audio/wav")},
        timeout=45,
    )
    body = {}
    try:
        body = res.json()
    except ValueError:
        body = {}
    if not res.ok:
        raise RuntimeError(body.get("error") or body.get("message") or f"word-ear HTTP {res.status_code}")
    text = body.get("text") or body.get("transcript") or ""
    if not str(text).strip():
        raise RuntimeError("The word-ear sent back silence")
    return str(text).strip()


def _porch_transcribe_wav(wav: bytes) -> str:
